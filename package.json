{
  "name": "ponoi",
  "private": true,
  "version": "1.392.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "gen-changelog": "node scripts/gen-changelog.mjs",
    "dev": "node scripts/gen-changelog.mjs && vite",
    "build": "node scripts/gen-changelog.mjs && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist": "node scripts/gen-changelog.mjs && vite build && electron-builder --win",
    "cap:sync": "npm run build && cap sync android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor #23272a --iconBackgroundColorDark #1e1f22 --splashBackgroundColor #23272a --splashBackgroundColorDark #1e1f22",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "test:crypto": "esbuild src/lib/crypto/__test.ts --bundle --format=iife --outfile=dist-crypto-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} && electron scripts/crypto-test.cjs",
    "test:db": "node scripts/db-test/rls-test.mjs",
    "test:plugins": "esbuild src/lib/plugins/__test.ts --bundle --platform=node --format=cjs --outfile=dist-plugin-test/t.cjs && node dist-plugin-test/t.cjs",
    "test:settings": "esbuild src/lib/__settings_test.ts --bundle --platform=node --format=esm --outfile=dist-settings-test/t.mjs && node dist-settings-test/t.mjs",
    "test:attack": "esbuild src/lib/plugins/__attack_test.ts --bundle --platform=node --format=esm --outfile=dist-attack-test/t.mjs && node dist-attack-test/t.mjs",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "test:ui": "esbuild src/lib/__ui_test.ts --bundle --platform=node --format=esm --outfile=dist-ui-test/t.mjs && node dist-ui-test/t.mjs",
    "test:i18n": "esbuild src/lib/__i18n_test.ts --bundle --format=iife --outfile=dist-i18n-test/t.js && electron scripts/i18n-test.cjs",
    "test:slash": "esbuild src/lib/__slash_test.ts --bundle --platform=node --format=esm --outfile=dist-slash-test/t.mjs && node dist-slash-test/t.mjs",
    "test:emoji": "esbuild src/lib/__emoji_test.ts --bundle --platform=node --format=esm --outfile=dist-emoji-test/t.mjs && node dist-emoji-test/t.mjs",
    "test:drag": "esbuild src/music/__drag_test.tsx --bundle --format=iife --jsx=automatic --outfile=dist-drag-test/t.js && electron scripts/drag-test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@fontsource/inter": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "@livekit/krisp-noise-filter": "^0.4.3",
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.3.9",
    "livekit-client": "^2.18.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.1",
    "@electric-sql/pglite": "^0.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ponoi.app",
    "productName": "Ponoi",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "ponoiai",
      "repo": "ponoi",
      "releaseType": "release"
    },
    "artifactName": "Ponoi-Setup-${version}.${ext}",
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "shortcutName": "Ponoi",
      "uninstallDisplayName": "Ponoi"
    }
  }
}
