{
  "name": "neylivo",
  "private": true,
  "version": "1.559.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "gen-changelog": "node scripts/gen-changelog.mjs",
    "dev": "node scripts/gen-changelog.mjs && vite",
    "build": "node scripts/gen-changelog.mjs && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist": "node scripts/gen-changelog.mjs && vite build && electron-builder --win",
    "cap:sync": "npm run build && cap sync android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor #23272a --iconBackgroundColorDark #1e1f22 --splashBackgroundColor #23272a --splashBackgroundColorDark #1e1f22",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "test:crypto": "esbuild src/lib/crypto/__test.ts --bundle --format=iife --outfile=dist-crypto-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/crypto-test.cjs",
    "test:db": "node scripts/db-test/rls-test.mjs",
    "test:plugins": "esbuild src/lib/plugins/__test.ts --bundle --platform=node --format=cjs --outfile=dist-plugin-test/t.cjs --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-plugin-test/t.cjs",
    "test:settings": "esbuild src/lib/__settings_test.ts --bundle --platform=node --format=esm --outfile=dist-settings-test/t.mjs --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-settings-test/t.mjs",
    "test:live": "esbuild src/lib/plugins/__live_test.ts --bundle --format=iife --outfile=dist-live-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/live-test.cjs",
    "test:attack": "esbuild src/lib/plugins/__attack_test.ts --bundle --platform=node --format=esm --outfile=dist-attack-test/t.mjs --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-attack-test/t.mjs",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "test:ui": "esbuild src/lib/__ui_test.ts --bundle --platform=node --format=esm --outfile=dist-ui-test/t.mjs --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-ui-test/t.mjs",
    "test:i18n": "esbuild src/lib/__i18n_test.ts --bundle --format=iife --outfile=dist-i18n-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/i18n-test.cjs",
    "test:slash": "esbuild src/lib/__slash_test.ts --bundle --platform=node --format=esm --outfile=dist-slash-test/t.mjs --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-slash-test/t.mjs",
    "test:emoji": "esbuild src/lib/__emoji_test.ts --bundle --platform=node --format=esm --outfile=dist-emoji-test/t.mjs --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-emoji-test/t.mjs",
    "test:back": "esbuild src/lib/__back_test.ts --bundle --format=iife --outfile=dist-back-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/back-test.cjs",
    "test:drag": "esbuild src/music/__drag_test.tsx --bundle --format=iife --jsx=automatic --outfile=dist-drag-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/drag-test.cjs",
    "test:lyrics": "esbuild src/music/__lyrics_test.ts --bundle --platform=node --format=esm --outfile=dist-lyrics-test/t.mjs --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-lyrics-test/t.mjs",
    "check:lyrics": "node scripts/lyrics-live.mjs",
    "test:music": "esbuild src/music/__music_test.ts --bundle --platform=node --format=esm --outfile=dist-music-test/t.mjs --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && node dist-music-test/t.mjs",
    "test:capture": "electron scripts/capture-test.cjs",
    "test:scene": "esbuild src/lib/plugins/__scene_test.ts --bundle --format=esm --outfile=dist-scene-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/scene-test.cjs",
    "test:safe": "electron scripts/safe-test.cjs",
    "test:java": "node scripts/java-test.mjs",
    "test:games": "node scripts/games-test.mjs",
    "test:snake": "esbuild src/lib/plugins/__snake_test.tsx --bundle --format=iife --jsx=automatic --outfile=dist-snake-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/snake-test.cjs",
    "test:api": "esbuild src/lib/plugins/__api_test.tsx --bundle --format=iife --jsx=automatic --outfile=dist-api-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/api-test.cjs",
    "test:play": "esbuild src/music/__play_test.ts --bundle --format=iife --outfile=dist-play-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/play-test.cjs",
    "test:mobback": "esbuild src/lib/plugins/__mobback_test.tsx --bundle --format=iife --jsx=automatic --outfile=dist-mobback-test/t.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/mobback-test.cjs",
    "gen-libs": "node scripts/gen-libs.mjs",
    "test:sheet": "electron scripts/sheet-test.cjs",
    "test:speak": "esbuild src/lib/__speak_test.ts --bundle --format=iife --outfile=dist-speak-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/speak-test.cjs",
    "test:mobile": "npm run build && electron scripts/mobile-test.cjs",
    "test:hover": "electron scripts/hover-test.cjs",
    "test:composer": "esbuild src/lib/keepFocus.ts --bundle --format=iife --global-name=KF --outfile=dist-composer-test/keepfocus.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/composer-test.cjs",
    "release:local": "node scripts/release-local.mjs",
    "test:save": "esbuild src/lib/__save_test.ts --bundle --format=iife --outfile=dist-save-test/t.js --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/save-test.cjs",
    "test:anim": "electron scripts/anim-test.cjs",
    "look": "electron scripts/look.cjs",
    "test:picker": "electron scripts/picker-test.cjs",
    "test:naked": "node scripts/naked-test.cjs",
    "test:clip": "electron scripts/clip-test.cjs",
    "test:bigfile": "esbuild src/lib/bigUpload.ts --bundle --format=iife --global-name=BF --outfile=dist-bigfile-test/bundle.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"http://127.0.0.1:39117\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"anon\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.css=empty && electron scripts/bigfile-test.cjs",
    "test:layout": "electron scripts/layout-test.cjs",
    "test:qr": "electron scripts/qr-test.cjs",
    "test:contrast": "electron scripts/contrast-test.cjs",
    "audit:ui": "node scripts/style-audit.cjs",
    "look:real": "esbuild src/components/__real_view.tsx --bundle --format=iife --jsx=automatic --outfile=dist-real-view/app.js --define:import.meta.env={\\\"VITE_SUPABASE_URL\\\":\\\"https://example.supabase.co\\\",\\\"VITE_SUPABASE_ANON_KEY\\\":\\\"test\\\"} --loader:.woff=empty --loader:.woff2=empty --loader:.jpg=dataurl --loader:.png=dataurl --loader:.css=empty && electron scripts/real-view.cjs",
    "test:stand": "node scripts/stand-honest.cjs",
    "test:call": "electron scripts/call-test.cjs",
    "test:reach": "electron scripts/reach-test.cjs",
    "test:nav": "esbuild src/lib/frameGuard.ts --bundle --format=iife --global-name=FG --outfile=dist-nav-test/frameguard.js && electron scripts/nav-test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "@huggingface/transformers": "^4.2.0",
    "@livekit/krisp-noise-filter": "^0.4.3",
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.3.9",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.18.7",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.1",
    "@electric-sql/pglite": "^0.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3",
    "replace": {
      "minimatch": "3.1.5"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "com.ponoi.app",
    "productName": "NeyLivo",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Neylivo",
      "repo": "neylivo",
      "releaseType": "release"
    },
    "artifactName": "NeyLivo-Setup-${version}.${ext}",
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "shortcutName": "NeyLivo",
      "uninstallDisplayName": "NeyLivo"
    }
  }
}
